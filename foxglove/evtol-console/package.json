{
  "name": "evtol-console",
  "publisher": "evtol",
  "version": "0.1.0",
  "displayName": "EVTOL Simulation Console",
  "description": "UE and ROS launch, scenario editing and speed-height flight profiles",
  "main": "./dist/extension.js",
  "license": "MIT",
  "scripts": {
    "build": "foxglove-extension build --mode production",
    "typecheck": "tsc --noEmit",
    "package": "foxglove-extension package",
    "local-install": "foxglove-extension install",
    "foxglove:prepublish": "npm run build"
  },
  "devDependencies": {
    "@foxglove/extension": "3.5.0",
    "create-foxglove-extension": "1.3.2",
    "jsdom": "24.1.3",
    "typescript": "5.8.3"
  }
}

  <exec_depend>evtol_sim_interfaces</exec_depend><exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend><exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

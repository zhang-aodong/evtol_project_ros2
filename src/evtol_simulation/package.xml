<?xml version="1.0"?>
<package format="3">
  <name>evtol_simulation</name><version>0.1.0</version>
  <description>Windows AirSim shared-memory sensors and observation generation only.</description>
  <maintainer email="maintainer@example.com">EVTOL Simulation</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>sensor_msgs</exec_depend>

Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
    Background Color: 30; 30; 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 5
      Plane Cell Count: 40
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR
      Enabled: true
      Topic:
        Value: /drone1/lidar/points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0
    - Class: rviz_default_plugins/Image
      Name: RGB
      Enabled: true
      Topic:
        Value: /drone1/camera/rgb/image_raw
        Reliability Policy: Best Effort
        Depth: 2
    - Class: rviz_default_plugins/Image
      Name: Semantic
      Enabled: true
      Topic:
        Value: /drone1/camera/semantic/image
        Reliability Policy: Best Effort
        Depth: 2
    - Class: rviz_default_plugins/Odometry
      Name: GroundTruth
      Enabled: true
      Topic:
        Value: /drone1/ground_truth/odometry
        Reliability Policy: Best Effort
        Depth: 10
      Keep: 200
      Shape: Arrow
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 50
      Pitch: 0.65
      Yaw: 0.8
      Focal Point: {X: 0, Y: 0, Z: 10}
Window Geometry:
  Width: 1400
  Height: 900

Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Enabled: true
  Value: true
  Name: root
  Global Options:
    Fixed Frame: map
    Frame Rate: 10
    Background Color: 30; 30; 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Value: true
      Cell Size: 5
      Plane Cell Count: 40
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR preview
      Enabled: true
      Value: true
      Topic:
        Value: /drone1/preview/lidar/points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0
    - Class: rviz_default_plugins/Image
      Name: RGB preview
      Enabled: true
      Value: true
      Topic:
        Value: /drone1/preview/rgb/image
        Reliability Policy: Best Effort
        Depth: 1
    - Class: rviz_default_plugins/Image
      Name: Semantic preview
      Enabled: false
      Value: false
      Topic:
        Value: /drone1/preview/semantic/image
        Reliability Policy: Best Effort
        Depth: 1
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 60
      Pitch: 0.65
      Yaw: 0.8
      Target Frame: drone1/base_link
      Focal Point: {X: 0, Y: 0, Z: 0}
Window Geometry:
  Width: 1200
  Height: 800

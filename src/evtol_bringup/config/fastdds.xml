<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>evtol_shm</transport_id>
      <type>SHM</type>
      <maxMessageSize>16777216</maxMessageSize>
      <segment_size>134217728</segment_size>
      <port_queue_capacity>1024</port_queue_capacity>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>evtol_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="evtol_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>evtol_shm</transport_id>
        <transport_id>evtol_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>

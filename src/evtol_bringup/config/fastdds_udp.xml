<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!-- UE sensor rings are unaffected: this selects ROS/DDS transport only. -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>evtol_udp</transport_id>
      <type>UDPv4</type>
      <sendBufferSize>16777216</sendBufferSize>
      <receiveBufferSize>33554432</receiveBufferSize>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="evtol_udp_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>evtol_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
